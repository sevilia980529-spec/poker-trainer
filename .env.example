# ─── 复制为 .env 后填写真实值。.env 已在 .gitignore 中，绝不入库 ───
# ⚠️ 下面三个变量都只在服务端（server/）使用，绝不可加 VITE_ 前缀，
#    否则会被 Vite 打进前端产物，密钥直接裸奔。

# Supabase 项目 URL（Dashboard → Project Settings → API → Project URL）
# 示例形如 https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service_role key（⚠️ 极高权限，绕过 RLS，仅服务端使用）
SUPABASE_SERVICE_ROLE_KEY=

# 会话令牌签名密钥，建议 ≥32 字符随机串；生产环境由 Render 自动生成
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 一体化服务器端口（本机 7100；Render 由平台注入 PORT）
PORT=7100
